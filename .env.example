# Telegram Bot Configuration
# 1. Create a bot with @BotFather on Telegram → get the token
# 2. Add the bot to your channel as an admin
# 3. Set the channel ID below (run server first, send a message, check logs for the ID)

TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHANNEL_ID=

# Server port
PORT=3000
